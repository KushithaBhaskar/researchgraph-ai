# Copy to .env and fill in. Never commit .env.
# AuraDB URIs look like neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Optional: enables LLM-written answers (grounded in retrieved evidence).
# Leave blank to use the deterministic fallback.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-5
